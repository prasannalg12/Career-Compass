
{
  "manifest_version": 3,
  "name": "CareerCompass",
  "version": "1.0.0",
  "description": "Your personal career guidance and learning assistant.",
  "action": {
    "default_title": "Open CareerCompass",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:4000/*"
  ]
}
